{
    "name": "php-baremetal/conductor",
    "description": "Composer plugin for php-baremetal: binds platform HALs, installs bm-* packages into .phpbm/packages and writes .phpbm/manifest.json.",
    "type": "composer-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "Gianfrancesco Aurecchia",
            "email": "gianfri@aurecchia.com"
        }
    ],
    "require": {
        "php": ">=8.4",
        "composer-plugin-api": "^2.0",
        "php-baremetal/spec": "^1.0"
    },
    "require-dev": {
        "composer/composer": "^2.8",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": { "PhpBaremetal\\Conductor\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "PhpBaremetal\\Conductor\\Tests\\": "tests/" }
    },
    "extra": {
        "class": "PhpBaremetal\\Conductor\\Plugin"
    }
}
